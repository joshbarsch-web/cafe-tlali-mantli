{% from "macros.njk" import buy, ph, steps %}{% set L = lang %}{% set U = urlbase %}{% set d = pg.drips %}
{% set title = d.title[L] %}{% set description = d.sub[L] %}
<section class="pink" style="padding:72px 0"><div class="wrap grid2"><div class="stack"><span class="kicker">{{ d.kicker[L] }}</span><h1 class="h-xl" style="line-height:.92">{{ d.title[L] }}</h1><p class="lede">{{ d.sub[L] }}</p><a class="btn btn-red" href="{{ U }}tienda/" style="align-self:flex-start">{{ d.ctaShop[L] }}</a></div>
<img src="{{ d.heroImage }}" alt="" style="width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:20px;max-height:560px"></div></section>
<section class="sec"><div class="wrap stack" style="gap:40px"><h2 class="h-md" style="color:var(--ink)">{{ d.howTitle[L] }}</h2>{{ steps(d.steps, L) }}<span class="muted" style="font-size:15px">{{ d.howNote[L] }}</span></div></section>
<section class="sec ink"><div class="wrap grid2" style="align-items:start;grid-template-columns:repeat(auto-fit,minmax(300px,1fr))"><h2 class="h-md" style="color:var(--pink)">{{ d.whyTitle[L] }}</h2><div class="list">{% for w in d.why %}<div><b>{{ w.title[L] }}</b><span>{{ w.body[L] }}</span></div>{% endfor %}</div></div></section>
<section class="sec"><div class="wrap stack" style="gap:28px"><h2 class="h-md">{{ d.pickBox[L] }}</h2>
<div class="grid3" style="grid-template-columns:repeat(auto-fit,minmax(240px,1fr))">{% for p in products %}{% if p.kind == 'drip' %}<div class="card" style="border-radius:20px;gap:10px"><span class="num-xl">{{ p.big }}</span><b style="font-size:18px">{{ p.name[L] }}</b><span class="muted" style="font-size:14px;line-height:1.45">{{ p.desc[L] }}</span>{% if p.cups %}<span style="font-weight:500;font-size:13px;color:var(--red)">{{ (p.price / p.cups) | round | mxn }} {{ ui.perCup[L] }}</span>{% endif %}
<div style="display:flex;justify-content:space-between;align-items:center;margin-top:auto;padding-top:14px"><span style="font-weight:700;font-size:18px">{{ p.price | mxn }}</span>{{ buy(p, L, U, ui, site, 'btn-red btn-sm') }}</div></div>{% endif %}{% endfor %}</div></div></section>
